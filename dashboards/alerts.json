{
  "folder": "BreachLab",
  "group": "breachlab-rules",
  "interval": "1m",
  "rules": [
    {
      "uid": "bl-canary",
      "title": "Canary failure",
      "condition": "C",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "OK",
      "annotations": {
        "summary": "A canary check failed in the last 75 minutes (hourly canary, ADR-0041)"
      },
      "labels": {
        "project": "breachlab"
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 4500,
            "to": 0
          },
          "datasourceUid": "${DS_UID}",
          "model": {
            "expr": "sum(sum_over_time(canary_failures_total[75m]))",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "A",
            "refId": "C",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "bl-l4-leak",
      "title": "Level 4 leak rate 2x baseline",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "OK",
      "annotations": {
        "summary": "L4 leaks over the last hour exceed twice the 7-day hourly baseline"
      },
      "labels": {
        "project": "breachlab"
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_UID}",
          "model": {
            "expr": "sum(increase(leaks_total{level=\"4\"}[1h])) - 2 * sum(increase(leaks_total{level=\"4\"}[7d])) / 168",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "A",
            "refId": "C",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "bl-guard-p95",
      "title": "Guard p95 above 500 ms",
      "condition": "C",
      "for": "10m",
      "noDataState": "OK",
      "execErrState": "OK",
      "annotations": {
        "summary": "Guard p95 latency above 500 ms for 10 minutes"
      },
      "labels": {
        "project": "breachlab"
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_UID}",
          "model": {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(guard_latency_seconds_bucket[5m])))",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "A",
            "refId": "C",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.5
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "bl-errors",
      "title": "Error rate above 2%",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "OK",
      "annotations": {
        "summary": "Error rate above 2% for 5 minutes"
      },
      "labels": {
        "project": "breachlab"
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_UID}",
          "model": {
            "expr": "sum(rate(errors_total[5m])) / clamp_min(sum(rate(requests_total[5m])), 1e-9)",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "A",
            "refId": "C",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.02
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "bl-spend",
      "title": "Daily spend above budget/30",
      "condition": "C",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "OK",
      "annotations": {
        "summary": "LLM spend in 24 h exceeds $5 (= $150 / 30)"
      },
      "labels": {
        "project": "breachlab"
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_UID}",
          "model": {
            "expr": "sum(increase(llm_cost_usd_total[24h]))",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "A",
            "refId": "C",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    5.0
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}