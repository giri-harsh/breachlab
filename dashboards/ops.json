{
  "uid": "bl-ops",
  "title": "BreachLab - Ops (canary and keep-warm)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Minutes since last successful canary",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        }
      },
      "targets": [
        {
          "expr": "(time() - max(last_over_time(canary_last_success_timestamp[3h]))) / 60",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Canary runs OK (one sample per hourly run)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(canary_ok_total[1h]))",
          "legendFormat": "ok runs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Canary failures per run",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(canary_failures_total[1h]))",
          "legendFormat": "failures",
          "refId": "A"
        },
        {
          "expr": "max(last_over_time(canary_last_run_failures[1h]))",
          "legendFormat": "failed checks in last run",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Guard Space unavailable (health check failed)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(guard_unavailable_total[1h]))",
          "legendFormat": "guard down",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Guard cold start vs warm latency (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max(last_over_time(guard_cold_start_seconds[2h]))",
          "legendFormat": "guard cold start",
          "refId": "A"
        },
        {
          "expr": "max(last_over_time(guard_warm_latency_seconds[2h]))",
          "legendFormat": "guard warm",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gateway cold start vs warm latency (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max(last_over_time(gateway_cold_start_seconds[2h]))",
          "legendFormat": "gateway cold start",
          "refId": "A"
        },
        {
          "expr": "max(last_over_time(gateway_warm_latency_seconds[2h]))",
          "legendFormat": "gateway warm",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Canary run duration (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max(last_over_time(canary_duration_seconds[2h]))",
          "legendFormat": "duration",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Guard up (last canary run; 0 = offline, known until a guard host exists)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "guard_up is 1 when the level-4 probe got a real answer, 0 when the gateway answered 503 'guard waking up'. No data = gateway down or canary not running.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "orange"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "min(last_over_time(guard_up[2h]))",
          "legendFormat": "guard",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Guard up per hourly run (0 = offline)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "min(last_over_time(guard_up[1h]))",
          "legendFormat": "guard_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Degraded canary runs (guard offline, tier 1 passed; not a failure)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "description": "canary_degraded_total is 1 on runs where only tier 1 (levels 1-2) ran because the guard host is not provisioned or unreachable (ADR draft E2-canary-degraded-mode). Red runs are in 'Canary failures per run'.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(canary_degraded_total[1h]))",
          "legendFormat": "degraded runs",
          "refId": "A"
        }
      ]
    }
  ],
  "tags": [
    "breachlab"
  ]
}
